<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher's "Talk to pi" shortcut (plan A11): opens the app straight into voice mode. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="talk-to-pi"
        android:enabled="true"
        android:icon="@drawable/voice_notification"
        android:shortcutShortLabel="@string/voice_shortcut_short"
        android:shortcutLongLabel="@string/voice_shortcut_long"
        android:shortcutDisabledMessage="@string/voice_shortcut_disabled">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="dev.pi_mobile.app"
            android:targetClass="dev.pi_mobile.app.MainActivity">
            <extra android:name="voice" android:value="true" />
        </intent>
    </shortcut>
</shortcuts>
