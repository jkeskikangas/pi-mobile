<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing is backed up or transferred. The machine keys (pi-secure) are sealed with a Keystore key that
     never leaves this phone, and the settings (pi-prefs) only make sense with them. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
