{
  "name": "pi-mobile",
  "version": "0.4.0",
  "description": "Continue every pi session from your phone: end-to-end encrypted, no server needed, answer any extension's dialogs, lock-screen notifications. Works in the browser, or with the native iPhone and Android apps.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "mobile",
    "remote-control",
    "phone",
    "web-push",
    "e2e"
  ],
  "license": "MIT",
  "author": "Jarno Keskikangas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jkeskikangas/pi-mobile.git"
  },
  "homepage": "https://github.com/jkeskikangas/pi-mobile#readme",
  "bugs": {
    "url": "https://github.com/jkeskikangas/pi-mobile/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "src",
    "web",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "workspaces": [
    "packages/pi-speech"
  ],
  "scripts": {
    "test": "PI_MOBILE_TAILSCALE=off node --experimental-strip-types --test test/*.test.ts packages/pi-speech/test/*.test.ts",
    "test:relay": "node --experimental-strip-types --no-warnings --test relay/test/*.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "ui": "node --experimental-strip-types --no-warnings test/ui/fixture.ts",
    "shots": "node test/ui/shots.mjs",
    "vectors": "node --experimental-strip-types --no-warnings test/vectors.ts"
  },
  "dependencies": {
    "pi-speech": "^0.1.0",
    "qrcode": "^1.5.4",
    "tweetnacl": "^1.0.3"
  },
  "bundleDependencies": [
    "pi-speech"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.5",
    "axe-core": "^4.14.0",
    "puppeteer-core": "^24.43.1",
    "typescript": "^7.0.2"
  },
  "bin": {
    "pi-mobile": "bin/pi-mobile.mjs"
  }
}
